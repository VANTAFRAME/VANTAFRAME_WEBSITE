---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero";
import Services from "../components/Services";
import Portfolio from "../components/Portfolio";
import VantaSignal from "../components/VantaSignal";
import Process from "../components/Process";
import Pricing from "../components/Pricing";
import About from "../components/About";
import Technologies from "../components/Technologies";
import FAQ from "../components/FAQ";
import { caseStudies } from "../data/caseStudies";
import Contact from "../components/Contact";
import ReferenceQuote from "../components/shared/ReferenceQuote";
import { languages } from "../i18n/translations";
const description =
  "VANTAFRAME wdraża AI i automatyzacje w firmach, buduje systemy i integracje oraz tworzy strony, sklepy i aplikacje. Studio z Krakowa.";
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "VANTAFRAME",
  url: "https://vantaframe.pl",
  description,
  inLanguage: "pl-PL",
  publisher: { "@id": "https://vantaframe.pl/#organization" },
};
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: languages.pl.faq.questions.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const caseOrder = caseStudies.map((cs) => ({ slug: cs.slug, liveUrl: cs.liveUrl }));
---
<Layout
  title="Wdrożenia AI, systemy i strony dla firm | VANTAFRAME"
  description={description}
  canonicalPath="/"
  structuredData={[websiteJsonLd, faqJsonLd]}
>
  <Navbar client:load pathname={Astro.url.pathname} />
  <main>
    <Hero client:load />
    <About client:visible />
    <Services client:visible />
    <Portfolio client:visible caseOrder={caseOrder} />
    <div class="relative z-10 bg-brand-black">
      <ReferenceQuote client:visible id="forum-ekonomiczne" variant="short" showRating />
    </div>
    <VantaSignal client:visible />
    <Process client:visible />
    <Technologies client:visible />
    <FAQ client:visible />
    <Pricing client:load />
    <Contact client:idle overlapClass="-mt-[96vh] md:-mt-[92vh]" />
  </main>
</Layout>