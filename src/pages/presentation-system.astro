---
import Layout from "../layouts/Layout.astro";
import DeckSystem from "../components/DeckSystem.astro";

const title = "Vantaframe: Strona jako System";
---

<Layout title={title} canonicalPath="/presentation-system" robots="noindex, nofollow">
    <!-- Controls (Hidden in Print) -->
    <div class="fixed top-4 right-4 z-50 print:hidden flex gap-4">
        <a
            href="/presentation"
            class="px-4 py-2 rounded-full text-sm font-bold transition-all border bg-black/50 text-white/50 border-white/20 hover:text-white"
        >
            Deck 1: Growth
        </a>
        <a
            href="/presentation-system"
            class="px-4 py-2 rounded-full text-sm font-bold transition-all border bg-white text-black border-white"
        >
            Deck 2: System
        </a>
        <button
            onclick="window.print()"
            class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded-full font-bold shadow-lg transition-all"
        >
            🖨️ Zapisz jako PDF
        </button>
    </div>

    <!-- Main Presentation Container -->
    <main class="w-full bg-[#050505]">
        <DeckSystem />
    </main>
</Layout>

<style is:global>
    /* Global Overrides for Presentation Mode */
    @media print {
        /* Hide Layout Elements */
        #cursor-follower,
        #legal-modals,
        header,
        footer,
        .corner-brackets {
            display: none !important;
        }

        /* Ensure Graphics are printed */
        body {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            background-color: #050505 !important;
        }

        /* Reset Page margins */
        @page {
            size: 1920px 1080px; /* Force 16:9 ratio if supported, or Landscape A4 */
            margin: 0;
        }
    }
</style>
