---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import Contact from "../components/Contact";
const title = "Realizacje: strony, sklepy i aplikacje | VANTAFRAME";
const description =
  "Wybrane realizacje VANTAFRAME: strony internetowe, sklepy, landing pages i aplikacje webowe dla firm i instytucji, m.in. SGH, AGH i Teatru SCALA.";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Strona główna", item: "https://vantaframe.pl/" },
    { "@type": "ListItem", position: 2, name: "Portfolio", item: "https://vantaframe.pl/portfolio/" },
  ],
};
---
<Layout
  title={title}
  description={description}
  canonicalPath="/portfolio"
  structuredData={[breadcrumbJsonLd]}
>
  <Navbar client:load pathname={Astro.url.pathname} />
  <main>
    <PortfolioGrid />
    <Contact client:load overlap={true} footerOnTop={true} />
  </main>
</Layout>