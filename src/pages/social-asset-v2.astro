---
import Layout from "../layouts/Layout.astro";
---

<Layout title="VANTAFRAME | Marketing Asset V2" canonicalPath="/social-asset-v2" robots="noindex, nofollow">
    <div
        class="fixed inset-0 flex items-center justify-center bg-brand-black overflow-hidden p-8"
    >
        <!-- Main Asset Container - 1200x630 (FB Standard) -->
        <div
            id="capture-area"
            class="relative w-[1200px] h-[630px] bg-brand-black border border-white/10 shadow-2xl overflow-hidden flex flex-col justify-between p-16"
        >
            <!-- Visual Background elements -->
            <div class="absolute inset-0 z-0">
                <div
                    class="absolute inset-0 opacity-[0.05]"
                    style="background-image: linear-gradient(to right, rgba(34, 211, 238, 0.3) 1px, transparent 1px), linear-gradient(to bottom, rgba(34, 211, 238, 0.3) 1px, transparent 1px); background-size: 80px 80px; -webkit-mask-image: radial-gradient(ellipse at center, black 10%, transparent 80%); mask-image: radial-gradient(ellipse at center, black 10%, transparent 80%);"
                >
                </div>
                <div
                    class="absolute -top-40 -left-40 w-[800px] h-[800px] bg-white/5 rounded-full blur-[120px]"
                >
                </div>
                <div
                    class="absolute -bottom-40 -right-40 w-[600px] h-[600px] bg-cyan-400/5 rounded-full blur-[120px]"
                >
                </div>
            </div>

            <!-- Branding Top -->
            <div class="relative z-10 flex justify-between items-start">
                <div class="flex flex-col">
                    <span
                        class="text-white/60 text-[10px] tracking-[0.5em] uppercase font-medium"
                        >Twoje wsparcie wizualne</span
                    >
                    <div class="h-[1px] w-12 bg-white/20 mt-1"></div>
                </div>
                <div
                    class="bg-white/5 backdrop-blur-sm px-4 py-1.5 rounded-full border border-white/10"
                >
                    <span
                        class="text-white/80 text-[10px] tracking-widest font-medium uppercase"
                        >High-End Digital Solutions</span
                    >
                </div>
            </div>

            <!-- Main Content Grid -->
            <div
                class="relative z-10 grid grid-cols-2 gap-12 items-center flex-grow py-8 h-full"
            >
                <!-- Left: Logo & Name -->
                <div class="flex flex-col items-center justify-center h-full">
                    <div class="relative group">
                        <div
                            class="absolute inset-0 bg-white/5 blur-[80px] rounded-full group-hover:bg-white/10 transition-all duration-1000"
                        >
                        </div>
                        <div
                            class="relative bg-white/5 p-12 rounded-full border border-white/10 backdrop-blur-sm flex items-center justify-center w-[360px] h-[360px]"
                        >
                            <img
                                src="/favicon.svg"
                                alt="VANTAFRAME Icon"
                                class="w-[200px] h-[200px] object-contain brightness-110 drop-shadow-[0_0_30px_rgba(255,255,255,0.2)]"
                            />
                        </div>
                    </div>
                </div>

                <!-- Right: Human-centric Value Props -->
                <div class="flex flex-col justify-center h-full gap-8 pr-8">
                    <div class="mb-4">
                        <h1
                            class="text-6xl font-black tracking-tighter text-white leading-none uppercase"
                        >
                            VANTA<span class="text-white/30">FRAME</span>
                        </h1>
                        <div class="w-16 h-[2px] bg-cyan-400 mt-4"></div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-3">
                            <div class="w-1.5 h-1.5 rounded-full bg-cyan-400">
                            </div>
                            <h3
                                class="text-xl font-bold uppercase tracking-[0.2em] text-white"
                            >
                                Zrozumienie biznesu
                            </h3>
                        </div>
                        <p
                            class="text-white/70 text-base leading-relaxed font-light pl-4.5 border-l border-white/10"
                        >
                            Zamiast lania wody, słuchamy Twoich potrzeb i
                            przekładamy je na konkretne efekty.
                        </p>
                    </div>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-3">
                            <div class="w-1.5 h-1.5 rounded-full bg-white/40">
                            </div>
                            <h3
                                class="text-xl font-bold uppercase tracking-[0.2em] text-white"
                            >
                                Design, który pracuje
                            </h3>
                        </div>
                        <p
                            class="text-white/70 text-base leading-relaxed font-light pl-4.5 border-l border-white/10"
                        >
                            Tworzymy narzędzia, które przyciągają klientów i
                            budują zaufanie od pierwszego kliknięcia.
                        </p>
                    </div>

                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-3">
                            <div class="w-1.5 h-1.5 rounded-full bg-white/20">
                            </div>
                            <h3
                                class="text-xl font-bold uppercase tracking-[0.2em] text-white"
                            >
                                Współpraca bez stresu
                            </h3>
                        </div>
                        <p
                            class="text-white/70 text-base leading-relaxed font-light pl-4.5 border-l border-white/10"
                        >
                            Prosty plan, jasna komunikacja i brak ukrytych
                            kosztów. Działamy po ludzku.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Bottom info -->
            <div
                class="relative z-10 flex justify-between items-end border-t border-white/10 pt-10 mt-auto"
            >
                <div class="flex flex-col gap-2">
                    <span
                        class="text-white/30 text-[9px] uppercase tracking-[0.3em] font-bold"
                        >Nasze hasło</span
                    >
                    <span
                        class="text-white/80 text-xl font-light italic tracking-wide italic"
                        >"VantaFrame – Tworzymy Twój wizerunek."</span
                    >
                </div>

                <div class="flex flex-col items-end">
                    <span
                        class="text-white/20 text-[8px] uppercase tracking-widest mb-1"
                        >Dostępny model współpracy 2026</span
                    >
                    <span class="text-4xl font-bold tracking-tight text-white"
                        >vantaframe.pl</span
                    >
                </div>
            </div>

            <!-- Frame marks -->
            <div
                class="absolute top-8 left-8 w-6 h-6 border-t border-l border-white/30"
            >
            </div>
            <div
                class="absolute top-8 right-8 w-6 h-6 border-t border-r border-white/30"
            >
            </div>
            <div
                class="absolute bottom-8 left-8 w-6 h-6 border-b border-l border-white/30"
            >
            </div>
            <div
                class="absolute bottom-8 right-8 w-6 h-6 border-b border-r border-white/30"
            >
            </div>
        </div>
    </div>

    <!-- Instruction for user (not part of the capture) -->
    <div
        class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-white/10 backdrop-blur-xl px-8 py-4 rounded-2xl border border-white/10 text-white/80 text-sm flex items-center gap-4 shadow-2xl"
    >
        <div class="w-2 h-2 bg-cyan-400 rounded-full animate-pulse"></div>
        <span
            >Drugi wariant marketingowy (Logo + Wartości) - Złap kadr 1200x630.</span
        >
    </div>
</Layout>

<style>
    :global(body) {
        overflow: hidden !important;
        background: #050505 !important;
    }

    #capture-area {
        box-shadow:
            0 0 100px rgba(0, 0, 0, 0.5),
            0 0 20px rgba(255, 255, 255, 0.02);
    }
</style>
