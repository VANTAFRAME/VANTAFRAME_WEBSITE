---
import Layout from "../layouts/Layout.astro";
---

<Layout title="VANTAFRAME | Marketing Asset" canonicalPath="/social-asset" robots="noindex, nofollow">
    <div
        class="fixed inset-0 flex items-center justify-center bg-brand-black overflow-hidden p-8"
    >
        <!-- Main Asset Container - 1200x630 (FB Standard) -->
        <div
            id="capture-area"
            class="relative w-[1200px] h-[630px] bg-brand-black border border-white/10 shadow-2xl overflow-hidden flex flex-col justify-between p-16"
        >
            <!-- Visual Background elements -->
            <div class="absolute inset-0 z-0">
                <div
                    class="absolute inset-0 opacity-[0.08]"
                    style="background-image: linear-gradient(to right, rgba(34, 211, 238, 0.3) 1px, transparent 1px), linear-gradient(to bottom, rgba(34, 211, 238, 0.3) 1px, transparent 1px); background-size: 80px 80px; -webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%); mask-image: radial-gradient(ellipse at center, black 20%, transparent 70%);"
                >
                </div>
                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/5 rounded-full blur-[100px]"
                >
                </div>
                <div
                    class="absolute -top-20 -right-20 w-[400px] h-[400px] bg-cyan-400/5 rounded-full blur-[120px]"
                >
                </div>

                {/* Soft accent glow colors */}
                <div
                    class="absolute -bottom-40 -left-20 w-[600px] h-[600px] bg-indigo-500/5 rounded-full blur-[120px]"
                >
                </div>
            </div>

            <!-- Branding / Navigation style Top -->
            <div class="relative z-10 flex justify-between items-start">
                <div class="flex flex-col">
                    <span
                        class="text-white/60 text-[10px] tracking-[0.5em] uppercase font-medium"
                        >Twoje wsparcie wizualne</span
                    >
                    <div class="h-[1px] w-12 bg-white/20 mt-1"></div>
                </div>
                <div
                    class="bg-white/5 backdrop-blur-sm px-4 py-1.5 rounded-full border border-white/10"
                >
                    <span
                        class="text-white/80 text-[10px] tracking-widest font-medium uppercase"
                        >High-End Digital Solutions</span
                    >
                </div>
            </div>

            <!-- Center Content -->
            <div class="relative z-10 flex flex-col items-center">
                <div
                    class="text-white/20 text-[8px] uppercase tracking-[1em] mb-4"
                >
                    Precision & Performance
                </div>
                <h1
                    class="text-[120px] font-black tracking-tighter text-white leading-[0.8] text-center mb-8"
                >
                    <span class="block">VANTA</span>
                    <span
                        class="block text-transparent bg-clip-text bg-gradient-to-b from-white to-white/30"
                        >FRAME</span
                    >
                </h1>

                <div class="flex items-center gap-4 mb-8">
                    <div
                        class="w-12 h-[1px] bg-gradient-to-r from-transparent to-white/40"
                    >
                    </div>
                    <div class="w-2 h-2 rounded-full border border-white/40">
                    </div>
                    <div
                        class="w-12 h-[1px] bg-gradient-to-l from-transparent to-white/40"
                    >
                    </div>
                </div>

                <p
                    class="text-2xl text-white/90 font-light tracking-[0.1em] uppercase text-center max-w-3xl leading-relaxed"
                >
                    Tworzymy strony, które <span
                        class="text-white font-bold underline underline-offset-8 decoration-white/20"
                        >sprzedają</span
                    > i budują Twój <span class="text-white font-bold"
                        >wizerunek</span
                    >
                </p>
            </div>

            <!-- Bottom info -->
            <div
                class="relative z-10 flex justify-between items-end border-t border-white/10 pt-10 mt-auto"
            >
                <div class="flex gap-16">
                    <div class="flex flex-col gap-2">
                        <span
                            class="text-white/30 text-[9px] uppercase tracking-[0.3em] font-bold"
                            >Stack</span
                        >
                        <div class="flex gap-4">
                            <span class="text-white/80 text-xs font-medium"
                                >ASTRO</span
                            >
                            <span class="text-white/40 text-xs">•</span>
                            <span class="text-white/80 text-xs font-medium"
                                >REACT</span
                            >
                            <span class="text-white/40 text-xs">•</span>
                            <span class="text-white/80 text-xs font-medium"
                                >GSAP</span
                            >
                        </div>
                    </div>
                    <div class="flex flex-col gap-2">
                        <span
                            class="text-white/30 text-[9px] uppercase tracking-[0.3em] font-bold"
                            >Usługi</span
                        >
                        <span
                            class="text-white/80 text-xs font-medium uppercase tracking-wider text-sm"
                            >Design / Develop / Growth</span
                        >
                    </div>
                </div>

                <div class="flex flex-col items-end">
                    <span
                        class="text-white/20 text-[8px] uppercase tracking-widest mb-1"
                        >Dostępny model współpracy 2026</span
                    >
                    <span class="text-4xl font-bold tracking-tight text-white"
                        >vantaframe.pl</span
                    >
                </div>
            </div>

            <!-- Decorative elements -->
            <div
                class="absolute top-1/2 left-8 -translate-y-1/2 flex flex-col gap-2 opacity-20"
            >
                <div class="w-1 h-1 bg-white"></div>
                <div class="w-1 h-1 bg-white"></div>
                <div class="w-1 h-1 bg-white"></div>
            </div>
            <div
                class="absolute top-1/2 right-8 -translate-y-1/2 flex flex-col gap-2 opacity-20"
            >
                <div class="w-1 h-1 bg-white"></div>
                <div class="w-1 h-1 bg-white"></div>
                <div class="w-1 h-1 bg-white"></div>
            </div>

            <!-- Frame marks -->
            <div
                class="absolute top-8 left-8 w-6 h-6 border-t border-l border-white/30"
            >
            </div>
            <div
                class="absolute top-8 right-8 w-6 h-6 border-t border-r border-white/30"
            >
            </div>
            <div
                class="absolute bottom-8 left-8 w-6 h-6 border-b border-l border-white/30"
            >
            </div>
            <div
                class="absolute bottom-8 right-8 w-6 h-6 border-b border-r border-white/30"
            >
            </div>
        </div>
    </div>

    <!-- Instruction for user (not part of the capture) -->
    <div
        class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-white/10 backdrop-blur-xl px-8 py-4 rounded-2xl border border-white/10 text-white/80 text-sm flex items-center gap-4 shadow-2xl"
    >
        <div class="w-2 h-2 bg-cyan-400 rounded-full animate-pulse"></div>
        <span
            >Użyj narzędzia <strong>Zrzut ekranu</strong> i zaznacz wewnętrzną ramkę
            (1200x630 px).</span
        >
    </div>
</Layout>

<style>
    /* Ensure clean background without any inherited scrollbars or weirdness */
    :global(body) {
        overflow: hidden !important;
        background: #050505 !important;
    }

    #capture-area {
        box-shadow:
            0 0 100px rgba(0, 0, 0, 0.5),
            0 0 20px rgba(255, 255, 255, 0.02);
    }

    h1 {
        font-family: "Outfit", sans-serif;
    }
</style>
