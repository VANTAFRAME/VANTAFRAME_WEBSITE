---
import "../styles/global.css";
import ScrollReveal from "../components/ScrollReveal.astro";
import { authors, authorJsonLd } from "../data/authors";
import Cursor from "../components/Cursor";
import CornerBrackets from "../components/CornerBrackets";
import LegalModals from "../components/LegalModals";
import CookieBanner from "../components/CookieBanner";
import PartnerModal from "../components/PartnerModal";
import LangSync from "../components/LangSync";
const DEFAULT_DESCRIPTION =
  "VANTAFRAME wdraża AI w firmach: automatyzacje procesów, agenci i asystenci AI, integracje z CRM i ERP oraz automatyzacja dokumentów. Projektujemy też strony, sklepy i dedykowane systemy. Studio z Krakowa.";
interface Props {
  title: string;
  /** Canonical path; `null` omits the canonical link and og:url (used by the 404 page). */
  canonicalPath?: string | null;
  pageMode?: "default" | "presentation" | "framework";
  showCookieBanner?: boolean;
  description?: string;
  /** Optional shorter titles/descriptions for social sharing; default to title/description. */
  ogTitle?: string;
  ogDescription?: string;
  robots?: string;
  /** Path of the social image (1200x630 PNG); defaults to /og-image.png. */
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown>[];
}
const {
  title,
  canonicalPath = "/",
  pageMode = "default",
  showCookieBanner = true,
  description = DEFAULT_DESCRIPTION,
  ogTitle,
  ogDescription,
  robots = "index, follow",
  ogImage = "/og-image.png",
  ogType = "website",
  structuredData = [],
} = Astro.props;
const siteUrl = "https://vantaframe.pl";
// Normalize to a trailing slash so the canonical/OG URL always matches the
// directory-style URLs Astro actually serves (/strony/, not /strony) —
// keeps crawlers from treating the two forms as separate pages.
const normalizedCanonicalPath =
  canonicalPath === null ? null : canonicalPath === "/" || canonicalPath.endsWith("/") ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = normalizedCanonicalPath === null ? null : new URL(normalizedCanonicalPath, siteUrl).toString();
const socialTitle = ogTitle || title;
const socialDescription = ogDescription || description;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    {/* "js" class: content hidden for reveal animations ([data-reveal], see global.css) is only hidden when JavaScript runs. */}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <!-- Google Tag Manager with Consent Mode v2 (basic mode).
         1. Consent defaults to "denied" for every Google consent type before
            anything else runs.
         2. GTM itself is only loaded once the visitor has accepted cookies in
            the banner (vf_cookie_consent_v1 === "accepted"); at that moment
            consent is updated to "granted" *before* gtm.js starts, so tags see
            the real state from their first evaluation.
         3. "Only essential" never loads GTM. If a visitor who had accepted
            switches to "only essential", CookieBanner calls __vfSetConsent(false).
         Switching to "advanced" mode (GTM always loaded, cookieless pings while
         denied) is a separate legal decision — see the Ads checklist. -->
    <script is:inline>
      (function () {
        var GTM_ID = "GTM-KVP2NVZ9";
        var CONSENT_KEY = "vf_cookie_consent_v1";
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = window.gtag || gtag;
        gtag("consent", "default", {
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
          analytics_storage: "denied",
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });
        window.__vfSetConsent = function (granted) {
          var state = granted ? "granted" : "denied";
          gtag("consent", "update", {
            ad_storage: state,
            ad_user_data: state,
            ad_personalization: state,
            analytics_storage: state,
          });
        };
        window.__vfLoadGTM = function () {
          if (window.__vfGtmLoaded) return;
          window.__vfGtmLoaded = true;
          window.__vfSetConsent(true);
          window.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = document.getElementsByTagName("script")[0];
          var j = document.createElement("script");
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + GTM_ID + "&l=dataLayer";
          f.parentNode.insertBefore(j, f);
        };
        try {
          var stored = JSON.parse(localStorage.getItem(CONSENT_KEY) || "null");
          if (stored && stored.type === "accepted") {
            window.__vfLoadGTM();
          }
        } catch (e) {}
      })();
    </script>
    <!-- End Google Tag Manager -->
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": `${siteUrl}/#organization`,
      name: "VANTAFRAME",
      legalName: "VANTAFRAME SPÓŁKA Z OGRANICZONĄ ODPOWIEDZIALNOŚCIĄ",
      url: siteUrl,
      logo: `${siteUrl}/icon-512.png`,
      image: `${siteUrl}/og-image.png`,
      description: DEFAULT_DESCRIPTION,
      founder: authorJsonLd(authors[0]),
      telephone: "+48794659528",
      email: "kontakt@vantaframe.pl",
      vatID: "PL9452332952",
      taxID: "9452332952",
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        streetAddress: "ul. Żułowska 33 lok. 10",
        addressLocality: "Kraków",
        postalCode: "31-436",
        addressRegion: "Małopolskie",
        addressCountry: "PL",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: 50.0867,
        longitude: 19.9612,
      },
      areaServed: [
        { "@type": "City", name: "Kraków" },
        { "@type": "AdministrativeArea", name: "Województwo Małopolskie" },
        { "@type": "Country", name: "Polska" },
      ],
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          opens: "08:00",
          closes: "18:00",
        },
      ],
      knowsAbout: [
        "Wdrożenia AI w firmach",
        "Automatyzacja procesów biznesowych",
        "Agenci AI",
        "Asystenci AI",
        "Integracje AI z CRM i ERP",
        "Automatyzacja dokumentów",
        "OpenAI",
        "Anthropic Claude",
        "Google Gemini",
        "n8n",
        "Make",
        "Google Workspace",
        "Projektowanie stron internetowych i sklepów",
        "Dedykowane systemy i aplikacje webowe",
      ],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Oferta VANTAFRAME",
        itemListElement: [
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Wdrożenia AI",
              url: `${siteUrl}/wdrozenia-ai/`,
              description: "Wdrażamy AI i automatyzacje w procesach firmy: od analizy po uruchomienie i monitoring.",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Strony i sklepy",
              url: `${siteUrl}/strony/`,
              description: "Strony i sklepy projektowane wokół Twojej marki, klientów i celów biznesowych.",
            },
          },
          {
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: "Systemy i aplikacje",
              url: `${siteUrl}/systemy/`,
              description: "Dedykowane systemy i aplikacje dopasowane do procesów firmy.",
            },
          },
        ],
      },
      department: {
        "@type": "Organization",
        name: "VANTASIGNAL",
        url: "https://vantasignal.pl/",
        description: "Marka VANTAFRAME zajmująca się widocznością firm w wyszukiwarkach i odpowiedziach AI (GEO i SEO).",
      },
      sameAs: [
        "https://www.linkedin.com/company/vantaframe/",
        "https://www.instagram.com/vantaframee/",
        "https://www.facebook.com/profile.php?id=61588309231679",
        "https://www.google.com/maps?cid=2449571422865794638",
      ],
      hasMap: "https://www.google.com/maps?cid=2449571422865794638",
    })} />
    {structuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="VANTAFRAME — wdrożenia AI, strony i systemy dla firm" />
    <meta property="og:site_name" content="VANTAFRAME" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="twitter:card" content="summary_large_image" />
    {canonicalUrl && <meta property="twitter:url" content={canonicalUrl} />}
    <meta property="twitter:title" content={socialTitle} />
    <meta property="twitter:description" content={socialDescription} />
    <meta property="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta property="twitter:image:alt" content="VANTAFRAME — wdrożenia AI, strony i systemy dla firm" />
    <!-- Outfit is self-hosted (public/fonts/outfit, @font-face in global.css). Only the latin file, which the
         first view needs, is preloaded; latin-ext (Polish diacritics) is fetched when a page uses those glyphs. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit/outfit-latin.woff2" crossorigin />
  </head>
  <body
    class:list={[
      "bg-[#050505] text-white overflow-x-hidden antialiased selection:bg-white selection:text-black",
      pageMode === "presentation" && "presentation-body",
    ]}
    data-page-mode={pageMode}
  >
    <!-- No GTM <noscript> iframe on purpose: without JavaScript there is no way to
         record cookie consent, so loading it would bypass the consent banner. -->
    <LangSync client:load />
    <Cursor client:media="(hover: hover) and (pointer: fine)" />
    <CornerBrackets client:media="(min-width: 768px)" />
    <LegalModals client:load />
    {showCookieBanner && <CookieBanner client:load />}
    <PartnerModal client:load pathname={canonicalPath ?? Astro.url.pathname} />
    <slot />
    <script>
      import Lenis from "lenis";
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      gsap.registerPlugin(ScrollTrigger);
      const LENIS_CONTROLLER_KEY = "__vfLenisController";
      const LENIS_DISABLED_MODES = ["presentation", "framework"];
      const shouldEnableLenis = () =>
        !LENIS_DISABLED_MODES.includes(document.body.dataset.pageMode || "");
      const createLenisController = () => {
        let lenis = null;
        let tickerCallback = null;
        const destroy = () => {
          if (tickerCallback) {
            gsap.ticker.remove(tickerCallback);
            tickerCallback = null;
          }
          if (lenis) {
            lenis.destroy();
            lenis = null;
          }
          delete window.lenis;
        };
        const init = () => {
          destroy();
          if (!shouldEnableLenis()) {
            return null;
          }
          lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
            wheelMultiplier: 0.9,
            touchMultiplier: 1.5,
          });
          tickerCallback = (time) => {
            lenis?.raf(time * 1000);
          };
          gsap.ticker.add(tickerCallback);
          gsap.ticker.lagSmoothing(0);
          lenis.on("scroll", ScrollTrigger.update);
          window.lenis = lenis;
          // Deliberate, click-triggered scrolls (nav links, logo-to-top)
          // need to be distinguishable from Lenis's OWN internal scrollTo()
          // calls, which it also uses under the hood to animate ordinary
          // smooth-wheel scrolling — wrapping lenis.scrollTo itself used to
          // flag those too, leaving window.__vfProgrammaticScroll true for
          // almost the entire duration of any regular wheel scroll (see
          // PartnerModal.jsx, which reads this flag to avoid opening the
          // partner popup mid-navigation-jump). Call this instead of
          // window.lenis.scrollTo() for anything triggered by a click, so
          // only intentional jumps get flagged.
          window.__vfLenisScrollTo = (target, options = {}) => {
            window.__vfProgrammaticScroll = true;
            const { onComplete, ...rest } = options;
            return lenis.scrollTo(target, {
              ...rest,
              onComplete: (...args) => {
                window.__vfProgrammaticScroll = false;
                onComplete?.(...args);
              },
            });
          };
          return lenis;
        };
        return {
          init,
          destroy,
          get instance() {
            return lenis;
          },
        };
      };
      const ensureLenisController = () => {
        if (window[LENIS_CONTROLLER_KEY]) {
          return window[LENIS_CONTROLLER_KEY];
        }
        const controller = createLenisController();
        window[LENIS_CONTROLLER_KEY] = controller;
        return controller;
      };
      const initLenis = () => {
        ensureLenisController().init();
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLenis);
      } else {
        initLenis();
      }
      document.addEventListener("astro:page-load", () => {
        initLenis();
      });
      // Plain `<a href="#id">` in-page anchors rely on the browser's native
      // hash-jump, which Lenis fights on the very next animation frame
      // (Lenis re-asserts its own tracked scroll position, so the native
      // jump gets silently overridden and the click appears to do nothing).
      // Route same-page anchor clicks through Lenis's own `scrollTo` instead,
      // so it knows about — and animates — the change itself.
      document.addEventListener("click", (event) => {
        if (event.defaultPrevented) return;
        const link = event.target.closest('a[href^="#"]');
        if (!link) return;
        const hash = link.getAttribute("href");
        if (!hash || hash === "#") return;
        const id = decodeURIComponent(hash.slice(1));
        const target = document.getElementById(id);
        if (!target) return;
        event.preventDefault();
        if (window.__vfLenisScrollTo) {
          window.__vfLenisScrollTo(target);
        } else {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    </script>
    <ScrollReveal />
  </body>
</html>