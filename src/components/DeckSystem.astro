---
import PresentationSlide from "./PresentationSlide.astro";
---

<!-- DECK 2: Strona jako System --><!-- Slajd 1: Tytuł -->
<PresentationSlide
    layout="title"
    title="Ekosystem Wzrostu"
    subtitle="Vantaframe System"
>
    <!-- Graphic: Minimal Node -->
    <div
        slot="graphic"
        class="relative w-full h-32 mb-8 flex justify-center items-center"
    >
        <div class="w-full max-w-xs h-px bg-white/20 relative">
            <div
                class="absolute left-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white border-2 border-black"
            >
            </div>
            <div
                class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white border-2 border-black"
            >
            </div>
            <div
                class="absolute left-1/2 top-1/2 -translate-y-1/2 w-3 h-3 bg-white border-2 border-black"
            >
            </div>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 2: Zmiana Paradygmatu -->
<PresentationSlide title="System, nie strona" subtitle="CORE PHILOSOPHY">
    <div class="grid grid-cols-2 gap-32 h-full items-center">
        <div>
            <h3
                class="text-xs font-mono uppercase tracking-[0.2em] text-gray-500 mb-8"
            >
                // Legacy
            </h3>
            <p
                class="text-4xl text-gray-500 font-light line-through decoration-1 decoration-gray-700"
            >
                Wizytówka
            </p>
            <p class="text-sm text-gray-600 mt-4 max-w-xs">
                Statyczny koszt. Ładny obrazek bez ROI.
            </p>
        </div>

        <div>
            <h3
                class="text-xs font-mono uppercase tracking-[0.2em] text-white mb-8"
            >
                // Vantaframe
            </h3>
            <p class="text-7xl text-white font-bold tracking-tight">
                Instrument Sprzedaży
            </p>
            <p
                class="text-xl text-gray-400 mt-6 max-w-md border-l border-white/20 pl-6"
            >
                Skalowalny zasób. Pracuje 24/7. Generuje leady.
            </p>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 3: Filar 1 Clarity -->
<PresentationSlide title="Clarity" subtitle="01">
    <div class="flex flex-col gap-16 h-full justify-center">
        <div class="max-w-4xl border-b border-white/10 pb-16">
            <h3
                class="text-8xl font-bold text-white leading-[0.9] tracking-tighter"
            >
                3 sekundy.
            </h3>
            <p class="text-2xl text-gray-500 mt-8 font-light max-w-xl">
                To cały czas, jaki masz, by zatrzymać klienta. Jeśli musi myśleć
                - odchodzi.
            </p>
        </div>

        <div class="grid grid-cols-3 gap-16 mt-8 opacity-80">
            <div>
                <h4
                    class="text-sm font-mono uppercase tracking-widest text-gray-500 mb-4"
                >
                    A
                </h4>
                <p class="text-xl text-white font-medium">Hierarchia</p>
            </div>
            <div>
                <h4
                    class="text-sm font-mono uppercase tracking-widest text-gray-500 mb-4"
                >
                    B
                </h4>
                <p class="text-xl text-white font-medium">Psychologia</p>
            </div>
            <div>
                <h4
                    class="text-sm font-mono uppercase tracking-widest text-gray-500 mb-4"
                >
                    C
                </h4>
                <p class="text-xl text-white font-medium">Konwersja</p>
            </div>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 4: Filar 2 Performance -->
<PresentationSlide title="Performance" subtitle="02">
    <div class="grid grid-cols-2 gap-32 items-center h-full">
        <div class="relative">
            <span
                class="text-[12rem] font-bold text-white leading-none tracking-tighter"
                >0.4s</span
            >
            <div class="h-1 w-full bg-white/10 mt-8 relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1/3 bg-white">
                </div>
            </div>
            <p
                class="text-xs font-mono uppercase tracking-widest text-gray-500 mt-4 text-right"
            >
                First Contentful Paint
            </p>
        </div>

        <div class="space-y-12 pl-12 border-l border-white/10">
            <ul class="space-y-12 text-2xl text-white font-light">
                <li>
                    Amazon: <span class="text-gray-500"
                        >1s opóźnienia = -1% przychodu</span>
                </li>
                <li>
                    Google: <span class="text-gray-500"
                        >Promuje tylko szybkie strony</span>
                </li>
                <li>
                    User: <span class="text-gray-500">Nie czeka. Nigdy.</span>
                </li>
            </ul>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 5: Filar 3 SEO -->
<PresentationSlide title="Visibility" subtitle="03">
    <div class="flex flex-col items-start justify-center h-full gap-24">
        <h3 class="text-7xl font-bold max-w-5xl leading-tight tracking-tight">
            Niewidzialni<br /><span class="text-gray-700">nie zarabiają.</span>
        </h3>

        <div class="grid grid-cols-3 gap-0 w-full border-t border-white/20">
            <div class="pt-8 pr-8 group">
                <h4
                    class="text-3xl font-bold mb-4 text-white group-hover:pl-4 transition-all"
                >
                    Tech SEO
                </h4>
                <p class="text-gray-500 text-sm">Semantyk, Meta tagi, XML.</p>
            </div>
            <div class="pt-8 px-8 border-l border-white/10 group">
                <h4
                    class="text-3xl font-bold mb-4 text-white group-hover:pl-4 transition-all"
                >
                    Schema
                </h4>
                <p class="text-gray-500 text-sm">Struktura danych dla AI.</p>
            </div>
            <div class="pt-8 pl-8 border-l border-white/10 group">
                <h4
                    class="text-3xl font-bold mb-4 text-white group-hover:pl-4 transition-all"
                >
                    Content
                </h4>
                <p class="text-gray-500 text-sm">Search Intent Architecture.</p>
            </div>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 6: Skalowalność -->
<PresentationSlide title="Scale" subtitle="04">
    <div class="grid grid-cols-2 gap-16 h-full items-center">
        <div class="pr-20">
            <div class="mb-16">
                <h4 class="text-white text-3xl font-bold mb-2">
                    Bezpieczeństwo
                </h4>
                <p class="text-gray-500">
                    Brak SQL. Brak Wordpressa. Brak luk.
                </p>
            </div>
            <div class="mb-16">
                <h4 class="text-white text-3xl font-bold mb-2">Global CDN</h4>
                <p class="text-gray-500">
                    Warszawa = Tokio. Ta sama milisekunda.
                </p>
            </div>
            <div>
                <h4 class="text-white text-3xl font-bold mb-2">
                    Traffic Spikes
                </h4>
                <p class="text-gray-500">
                    Architektura Serverless. Nieskończona skalowalność.
                </p>
            </div>
        </div>

        <!-- Abstract Visual -->
        <div
            class="h-full w-full border border-white/10 rounded-full flex items-center justify-center opacity-20 animate-pulse"
        >
            <div class="w-2/3 h-2/3 border border-white/30 rounded-full"></div>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 7: Pakiety Systemowe -->
<PresentationSlide title="Inwestycja" subtitle="MODELE WSPÓŁPRACY">
    <div class="grid grid-cols-3 gap-0 mt-20 h-full border-t border-white/20">
        <!-- Start -->
        <div
            class="pt-12 pr-12 border-r border-white/10 opacity-60 hover:opacity-100 transition-opacity"
        >
            <h4
                class="text-xl font-mono text-gray-500 mb-6 uppercase tracking-widest"
            >
                Start
            </h4>
            <div class="text-5xl font-bold text-white mb-4">Foundation</div>
            <p class="text-gray-500 mt-8 text-sm">
                Niezbędne minimum.<br />Perfekcyjne UX.
            </p>
        </div>

        <!-- Growth -->
        <div class="pt-12 px-12 border-r border-white/10 relative">
            <div class="absolute top-0 left-0 w-full h-1 bg-white"></div>
            <h4
                class="text-xl font-mono text-white mb-6 uppercase tracking-widest"
            >
                Growth
            </h4>
            <div class="text-5xl font-bold text-white mb-4">Expansion</div>
            <p class="text-gray-400 mt-8 text-sm">
                Budowanie Lidera.<br />CMS + Integracje.
            </p>
        </div>

        <!-- Scale -->
        <div
            class="pt-12 pl-12 opacity-60 hover:opacity-100 transition-opacity"
        >
            <h4
                class="text-xl font-mono text-gray-500 mb-6 uppercase tracking-widest"
            >
                Scale
            </h4>
            <div class="text-5xl font-bold text-white mb-4">Automation</div>
            <p class="text-gray-500 mt-8 text-sm">
                Pełna automatyzacja.<br />E-commerce B2B.
            </p>
        </div>
    </div>
</PresentationSlide>

<!-- Slajd 8: CTA -->
<div class="text-center max-w-5xl mx-auto flex flex-col items-center">
    <h2 class="text-[8rem] font-bold mb-10 tracking-tighter leading-none">
        Twój Ruch
    </h2>
    <div class="w-px h-20 bg-white/20 mb-10"></div>
    <div class="flex flex-col items-center gap-8">
        <span class="text-2xl tracking-[0.2em] font-light"
            >kontakt@vantaframe.pl</span
        >
    </div>
</div>
