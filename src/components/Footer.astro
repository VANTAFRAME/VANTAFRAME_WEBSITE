---
const currentYear = new Date().getFullYear();
---

<footer class="bg-black text-white py-12 px-5 sm:px-6 md:px-12 relative z-20 border-t border-white/10">
  <div class="max-w-[1800px] mx-auto flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <!-- Brand & Copyright -->
    <div class="flex flex-col items-center lg:items-start gap-1">
      <span class="text-[clamp(1.75rem,5vw,2.25rem)] font-bold tracking-tight leading-none text-white">VANTAFRAME</span>
      <span class="text-xs text-white/50">&copy; {currentYear} VANTAFRAME. Wszelkie prawa zastrzeżone.</span>
    </div>

    <!-- Company Registration Details (KRS, REGON, NIP, Siedziba) -->
    <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-xs text-white/70 bg-white/[0.04] border border-white/10 px-6 py-3 rounded-full shadow-inner">
      <div class="flex items-center gap-1.5">
        <span class="font-medium text-white/90 uppercase tracking-wider text-[11px]">Siedziba</span>
        <span class="text-white/90 font-semibold">Kraków, Polska</span>
      </div>
      <span class="hidden sm:inline text-white/20">•</span>
      <div class="flex items-center gap-1.5">
        <span class="font-medium text-white/90 uppercase tracking-wider text-[11px]">KRS</span>
        <span class="font-mono text-white/80 font-semibold">0001253958</span>
      </div>
      <span class="hidden sm:inline text-white/20">•</span>
      <div class="flex items-center gap-1.5">
        <span class="font-medium text-white/90 uppercase tracking-wider text-[11px]">REGON</span>
        <span class="font-mono text-white/80 font-semibold">54524537200000</span>
      </div>
      <span class="hidden sm:inline text-white/20">•</span>
      <div class="flex items-center gap-1.5">
        <span class="font-medium text-white/90 uppercase tracking-wider text-[11px]">NIP</span>
        <span class="font-mono text-white/80 font-semibold">9452332952</span>
      </div>
    </div>

    <!-- Navigation & Social Links -->
    <div class="flex flex-wrap justify-center lg:justify-end gap-x-6 gap-y-2 text-xs sm:text-sm text-white/70 font-medium">
      <button id="privacy-link" class="hover:text-white transition-colors">Polityka prywatności</button>
      <button id="cookie-settings-link" class="hover:text-white transition-colors">Ustawienia cookies</button>
      <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a>
      <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">LinkedIn</a>
    </div>
  </div>
</footer>

<script>
  import { togglePrivacy } from "../stores/legalStore";

  const privacyBtn = document.getElementById("privacy-link");
  const cookieSettingsBtn = document.getElementById("cookie-settings-link");

  if (privacyBtn) {
    privacyBtn.addEventListener("click", (e) => {
      e.preventDefault();
      togglePrivacy(true);
    });
  }

  if (cookieSettingsBtn) {
    cookieSettingsBtn.addEventListener("click", (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent("open-cookie-settings"));
    });
  }
</script>
